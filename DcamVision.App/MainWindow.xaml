<Window x:Class="DcamVision.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DcamVision.App.Controls"
        Title="DCAM Vision Studio"
        MinHeight="720"
        MinWidth="1120"
        Height="820"
        Width="1320"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
            <RowDefinition Height="188" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="22,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="DCAM Vision Studio"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               FontSize="22"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Scientific Camera Control"
                               Style="{StaticResource MutedText}"
                               Margin="0,3,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Ellipse Width="10"
                             Height="10"
                             Fill="{Binding StatusIndicatorBrush}"
                             Margin="0,0,8,0" />
                    <StackPanel>
                        <TextBlock Text="{Binding HeaderStatusText}"
                                   Style="{StaticResource ValueText}"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding HeaderDeviceText}"
                                   Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding HeaderSimulatorText}"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right"
                                   Visibility="{Binding HasSelectedDevice, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16,16,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource PanelBorder}"
                    Padding="14">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CAMERA"
                                       Style="{StaticResource SectionHeadingText}"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Content="Discover"
                                    Command="{Binding DiscoverCommand}"
                                    ToolTip="Scan for available cameras"
                                    TabIndex="0" />
                        </Grid>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Camera Source"
                                           Style="{StaticResource LabelText}"
                                           Margin="0,0,0,6" />
                                <ComboBox ItemsSource="{Binding CameraBackends}"
                                          SelectedItem="{Binding SelectedCameraBackend}"
                                          ToolTip="Choose Auto, Simulator, or Hamamatsu DCAM discovery"
                                          TabIndex="1" />
                                <TextBlock Text="{Binding DcamRuntimeStatusText}"
                                           Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedDeviceName}"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <Border Background="#243C45"
                                        BorderBrush="{StaticResource AccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="7,3"
                                        HorizontalAlignment="Left"
                                        Margin="0,8,0,10">
                                    <TextBlock Text="{Binding SelectedDeviceKind}"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               FontSize="11"
                                               FontWeight="SemiBold" />
                                </Border>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Manufacturer" Style="{StaticResource LabelText}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedManufacturer}" Style="{StaticResource ValueText}" />
                                    <TextBlock Grid.Row="1" Text="Model" Style="{StaticResource LabelText}" Margin="0,7,0,0" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedModel}" Style="{StaticResource ValueText}" Margin="0,7,0,0" />
                                    <TextBlock Grid.Row="2" Text="Serial" Style="{StaticResource LabelText}" Margin="0,7,0,0" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedSerialNumber}" Style="{StaticResource ValueText}" Margin="0,7,0,0" />
                                    <TextBlock Grid.Row="3" Text="Status" Style="{StaticResource LabelText}" Margin="0,7,0,0" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedConnectionState}" Style="{StaticResource ValueText}" Margin="0,7,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <TextBlock Text="CONTROLS"
                                   Style="{StaticResource SectionHeadingText}"
                                   Margin="0,0,0,10" />
                        <Button Content="{Binding ConnectButtonText}"
                                Command="{Binding ToggleConnectionCommand}"
                                Style="{StaticResource PrimaryButton}"
                                ToolTip="Connect or disconnect the selected camera"
                                TabIndex="2" />
                    </StackPanel>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Devices"
                                   Style="{StaticResource LabelText}"
                                   Margin="0,0,0,6" />
                        <Grid Grid.Row="1">
                            <ListBox ItemsSource="{Binding Devices}"
                                     SelectedItem="{Binding SelectedDevice}"
                                     DisplayMemberPath="DisplayName"
                                     TabIndex="2" />
                            <StackPanel VerticalAlignment="Center"
                                        Margin="16"
                                        Visibility="{Binding NoDevices, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="No cameras discovered"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Run discovery to find available devices."
                                           Style="{StaticResource MutedText}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </DockPanel>
            </Border>

            <Border Grid.Column="1"
                    Margin="14,0"
                    Style="{StaticResource PanelBorder}"
                    Background="{StaticResource ViewportBackgroundBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="14,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="LIVE IMAGE VIEW"
                                   Style="{StaticResource SectionHeadingText}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="{Binding PreviewModeText}"
                                       Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0" />
                            <Button Content="Return Current"
                                    Command="{Binding ReturnToCurrentFrameCommand}"
                                    Style="{StaticResource ToolbarButton}"
                                    ToolTip="Return the preview to the latest current frame"
                                    Margin="0,0,8,0" />
                            <Button Content="Save Current"
                                    Command="{Binding SaveCurrentFrameCommand}"
                                    Style="{StaticResource ToolbarButton}"
                                    ToolTip="Save the latest current frame to capture history"
                                    Margin="0,0,12,0" />
                            <Button Content="Fit"
                                    Style="{StaticResource ToolbarButton}"
                                    IsEnabled="False"
                                    ToolTip="Fit view mode is the current Phase 2 display mode"
                                    Margin="0,0,8,0" />
                            <Button Content="100%"
                                    Style="{StaticResource ToolbarButton}"
                                    IsEnabled="False"
                                    ToolTip="Pixel-accurate zoom is planned for a later phase"
                                    Margin="0,0,12,0" />
                            <TextBlock Text="{Binding EffectiveDisplayRangeText, StringFormat=Display Range: {0}}"
                                       Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="14,0,14,12">
                        <Border BorderBrush="#27333F"
                                BorderThickness="1"
                                Background="#05080B">
                            <Grid ClipToBounds="True">
                                <Image Source="{Binding PreviewImage}"
                                       Stretch="Uniform"
                                       SnapsToDevicePixels="True" />
                                <StackPanel VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            Visibility="{Binding NoPreviewImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="No image available"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Connect to a camera and capture a frame or start live acquisition."
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="13"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               MaxWidth="360"
                                               Margin="0,8,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2"
                            Background="#111922"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="14,10">
                        <UniformGrid Columns="5">
                            <StackPanel>
                                <TextBlock Text="Frame" Style="{StaticResource LabelText}" />
                                <TextBlock Text="{Binding FrameNumberText}" Style="{StaticResource ValueText}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Dimensions" Style="{StaticResource LabelText}" />
                                <TextBlock Text="{Binding FrameDimensionsText}" Style="{StaticResource ValueText}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Pixel Format" Style="{StaticResource LabelText}" />
                                <TextBlock Text="{Binding FramePixelFormatText}" Style="{StaticResource ValueText}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Exposure" Style="{StaticResource LabelText}" />
                                <TextBlock Text="{Binding FrameExposureText}" Style="{StaticResource ValueText}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Timestamp" Style="{StaticResource LabelText}" />
                                <TextBlock Text="{Binding FrameTimestampText}" Style="{StaticResource ValueText}" />
                            </StackPanel>
                        </UniformGrid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource PanelBorder}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="CAMERA SETTINGS"
                                   Style="{StaticResource SectionHeadingText}"
                                   Margin="0,0,0,12" />

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Live Acquisition"
                                           Style="{StaticResource SectionHeadingText}"
                                           Margin="0,0,0,10" />
                                <TextBlock Text="{Binding LiveStateText}"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Content="Capture"
                                            Command="{Binding CaptureCommand}"
                                            Style="{StaticResource PrimaryButton}"
                                            ToolTip="Capture one frame"
                                            TabIndex="3"
                                            Margin="0,0,6,0" />
                                    <Button Grid.Column="1"
                                            Content="Start Live"
                                            Command="{Binding StartLiveCommand}"
                                            ToolTip="Start continuous simulated acquisition"
                                            TabIndex="4"
                                            Margin="6,0,0,0" />
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="Pause Preview"
                                            Command="{Binding PausePreviewCommand}"
                                            ToolTip="Pause preview display while acquisition continues"
                                            TabIndex="5"
                                            Margin="0,0,6,0" />
                                    <Button Grid.Column="1"
                                            Content="Resume Preview"
                                            Command="{Binding ResumePreviewCommand}"
                                            ToolTip="Resume preview display using the newest processed frame"
                                            TabIndex="6"
                                            Margin="6,0,0,0" />
                                </Grid>
                                <Button Content="Stop Live"
                                        Command="{Binding StopLiveCommand}"
                                        Style="{StaticResource DangerButton}"
                                        ToolTip="Stop continuous acquisition"
                                        TabIndex="7"
                                        Margin="0,10,0,0" />
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Acquisition FPS" Style="{StaticResource LabelText}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AcquisitionFpsText}" Style="{StaticResource ValueText}" />
                                    <TextBlock Grid.Row="1" Text="Display FPS" Style="{StaticResource LabelText}" Margin="0,5,0,0" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DisplayFpsText}" Style="{StaticResource ValueText}" Margin="0,5,0,0" />
                                    <TextBlock Grid.Row="2" Text="Acquired" Style="{StaticResource LabelText}" Margin="0,5,0,0" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FramesAcquiredText}" Style="{StaticResource ValueText}" Margin="0,5,0,0" />
                                    <TextBlock Grid.Row="3" Text="Processed" Style="{StaticResource LabelText}" Margin="0,5,0,0" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding FramesProcessedText}" Style="{StaticResource ValueText}" Margin="0,5,0,0" />
                                    <TextBlock Grid.Row="4" Text="Displayed" Style="{StaticResource LabelText}" Margin="0,5,0,0" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding FramesDisplayedText}" Style="{StaticResource ValueText}" Margin="0,5,0,0" />
                                    <TextBlock Grid.Row="5" Text="Pipeline Drops" Style="{StaticResource LabelText}" Margin="0,5,0,0" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding PipelineDropsText}" Style="{StaticResource ValueText}" Margin="0,5,0,0" />
                                    <TextBlock Grid.Row="6" Text="Source Gaps" Style="{StaticResource LabelText}" Margin="0,5,0,0" />
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SourceFrameGapsText}" Style="{StaticResource ValueText}" Margin="0,5,0,0" />
                                    <TextBlock Grid.Row="7" Text="Buffer" Style="{StaticResource LabelText}" Margin="0,5,0,0" />
                                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding BufferOccupancyText}" Style="{StaticResource ValueText}" Margin="0,5,0,0" />
                                    <TextBlock Grid.Row="8" Text="Session" Style="{StaticResource LabelText}" Margin="0,5,0,0" />
                                    <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding SessionElapsedText}" Style="{StaticResource ValueText}" Margin="0,5,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Image Processing"
                                           Style="{StaticResource SectionHeadingText}"
                                           Margin="0,0,0,10" />
                                <TextBlock Text="Display Presets" Style="{StaticResource LabelText}" />
                                <ItemsControl ItemsSource="{Binding DisplayPresets}" Margin="0,4,0,10">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding}"
                                                    Command="{Binding DataContext.ApplyDisplayPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Apply display preset"
                                                    Margin="0,0,8,8" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Auto Contrast" Style="{StaticResource LabelText}" />
                                <ComboBox ItemsSource="{Binding AutoContrastModes}"
                                          SelectedItem="{Binding SelectedAutoContrastMode}"
                                          Margin="0,4,0,10"
                                          ToolTip="Choose manual, min/max, or percentile display contrast" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Text="Black Point" Style="{StaticResource LabelText}" />
                                        <TextBox Text="{Binding BlackPointValue, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,4" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="White Point" Style="{StaticResource LabelText}" />
                                        <TextBox Text="{Binding WhitePointValue, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,4" />
                                    </StackPanel>
                                </Grid>
                                <Slider Minimum="0"
                                        Maximum="65535"
                                        Value="{Binding BlackPointValue, UpdateSourceTrigger=PropertyChanged}"
                                        ToolTip="Manual black point"
                                        Margin="0,4,0,0" />
                                <Slider Minimum="0"
                                        Maximum="65535"
                                        Value="{Binding WhitePointValue, UpdateSourceTrigger=PropertyChanged}"
                                        ToolTip="Manual white point"
                                        Margin="0,4,0,10" />

                                <TextBlock Text="Gamma" Style="{StaticResource LabelText}" />
                                <TextBox Text="{Binding GammaValue, UpdateSourceTrigger=PropertyChanged, StringFormat=0.00}"
                                         Margin="0,4,0,4"
                                         ToolTip="Gamma range is 0.1 to 5.0" />
                                <Slider Minimum="0.1"
                                        Maximum="5"
                                        Value="{Binding GammaValue, UpdateSourceTrigger=PropertyChanged}"
                                        TickFrequency="0.1"
                                        Margin="0,0,0,10" />

                                <CheckBox Content="Invert Display"
                                          IsChecked="{Binding InvertDisplay}"
                                          ToolTip="Invert the preview grayscale output only"
                                          Margin="0,0,0,8" />
                                <CheckBox Content="Threshold"
                                          IsChecked="{Binding ThresholdEnabled}"
                                          ToolTip="Render pixels below threshold black and pixels at or above threshold white"
                                          Margin="0,0,0,6" />
                                <TextBox Text="{Binding ThresholdValue, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Threshold value from 0 to 65535"
                                         Margin="0,0,0,10" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Text="Histogram Scale" Style="{StaticResource LabelText}" />
                                        <ComboBox ItemsSource="{Binding HistogramScales}"
                                                  SelectedItem="{Binding SelectedHistogramScale}"
                                                  Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="Histogram Range" Style="{StaticResource LabelText}" />
                                        <ComboBox ItemsSource="{Binding HistogramDisplayRanges}"
                                                  SelectedItem="{Binding SelectedHistogramDisplayRange}"
                                                  Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{Binding DisplayValidationMessage}"
                                           Foreground="{StaticResource WarningBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding HasDisplayValidationMessage, Converter={StaticResource BooleanToVisibilityConverter}}"
                                           Margin="0,10,0,0" />

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Processing" Style="{StaticResource LabelText}" />
                                    <TextBlock Grid.Column="1" Text="{Binding ProcessingTimeText}" Style="{StaticResource ValueText}" />
                                    <TextBlock Grid.Row="1" Text="Shadows Clipped" Style="{StaticResource LabelText}" Margin="0,5,0,0" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BlackClippedText}" Style="{StaticResource ValueText}" Margin="0,5,0,0" />
                                    <TextBlock Grid.Row="2" Text="Highlights Clipped" Style="{StaticResource LabelText}" Margin="0,5,0,0" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding WhiteClippedText}" Style="{StaticResource ValueText}" Margin="0,5,0,0" />
                                    <TextBlock Grid.Row="3" Text="Threshold Split" Style="{StaticResource LabelText}" Margin="0,5,0,0" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ThresholdSplitText}" Style="{StaticResource ValueText}" Margin="0,5,0,0" />
                                </Grid>

                                <Button Content="Reset Display"
                                        Command="{Binding ResetDisplayCommand}"
                                        ToolTip="Restore raw display mapping without changing camera settings"
                                        Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Exposure Time"
                                           Style="{StaticResource SectionHeadingText}"
                                           Margin="0,0,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="96" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding ExposureValue, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Enter an exposure in the selected unit"
                                             TabIndex="6">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding ApplyExposureCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding ExposureUnits}"
                                              SelectedItem="{Binding SelectedExposureUnit}"
                                              Margin="8,0,0,0"
                                              TabIndex="7">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource ExposureUnitLabelConverter}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                                <Slider Minimum="0"
                                        Maximum="100"
                                        Value="{Binding ExposureSliderValue, UpdateSourceTrigger=PropertyChanged}"
                                        TickFrequency="20"
                                        IsSnapToTickEnabled="False"
                                        ToolTip="Logarithmic exposure adjustment"
                                        Margin="0,12,0,0"
                                        TabIndex="8" />
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="100 µs" Style="{StaticResource MutedText}" />
                                    <TextBlock Grid.Column="1" Text="100 ms" Style="{StaticResource MutedText}" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="10 s" Style="{StaticResource MutedText}" HorizontalAlignment="Right" />
                                </Grid>
                                <TextBlock Text="Current:"
                                           Style="{StaticResource LabelText}"
                                           Margin="0,10,0,0" />
                                <TextBlock Text="{Binding CurrentExposureText}"
                                           Style="{StaticResource ValueText}" />
                                <TextBlock Text="{Binding SupportedExposureRangeText, StringFormat=Supported range: {0}}"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,6,0,0" />
                                <TextBlock Text="{Binding PendingExposureText, StringFormat=Pending: {0}}"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,4,0,0" />
                                <TextBlock Text="{Binding ExposureValidationMessage}"
                                           Foreground="{StaticResource WarningBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0"
                                           Visibility="{Binding HasExposureValidationMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Button Content="Apply Exposure"
                                        Command="{Binding ApplyExposureCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        IsDefault="True"
                                        ToolTip="Apply the exposure value to the camera service"
                                        TabIndex="9"
                                        Margin="0,12,0,0" />
                                <TextBlock Text="Presets"
                                           Style="{StaticResource LabelText}"
                                           Margin="0,14,0,8" />
                                <ItemsControl ItemsSource="{Binding ExposurePresets}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding DisplayName}"
                                                    Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding IsSupported}"
                                                    ToolTip="Apply exposure preset"
                                                    Margin="0,0,8,8">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource AccentDarkBrush}" />
                                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Property Summary"
                                           Style="{StaticResource SectionHeadingText}"
                                           Margin="0,0,0,10" />
                                <ItemsControl ItemsSource="{Binding PropertySummaries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource LabelText}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource ValueText}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Connect to a camera to load properties."
                                           Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding IsDisconnected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Capture History"
                                           Style="{StaticResource SectionHeadingText}"
                                           Margin="0,0,0,10" />
                                <TextBlock Text="{Binding CaptureHistory.SummaryText}"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,0,0,8" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding CaptureHistory.SessionName, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Active capture session name"
                                             Margin="0,0,8,0" />
                                    <Button Grid.Column="1"
                                            Content="Rename"
                                            Command="{Binding CaptureHistory.RenameSessionCommand}" />
                                </Grid>
                                <Button Content="New Session"
                                        Command="{Binding CaptureHistory.NewSessionCommand}"
                                        ToolTip="Start a new in-memory capture session"
                                        Margin="0,0,0,10" />

                                <TextBlock Text="Search" Style="{StaticResource LabelText}" />
                                <TextBox Text="{Binding CaptureHistory.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Search notes, tags, model, serial, session, ID, or source"
                                         Margin="0,4,0,8" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Text="Session" Style="{StaticResource LabelText}" />
                                        <ComboBox ItemsSource="{Binding CaptureHistory.Sessions}"
                                                  SelectedItem="{Binding CaptureHistory.SelectedSession}"
                                                  DisplayMemberPath="Name"
                                                  Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="Source" Style="{StaticResource LabelText}" />
                                        <ComboBox ItemsSource="{Binding CaptureHistory.SourceOptions}"
                                                  SelectedItem="{Binding CaptureHistory.SelectedSource}"
                                                  Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                                <ComboBox ItemsSource="{Binding CaptureHistory.SortModes}"
                                          SelectedItem="{Binding CaptureHistory.SelectedSortMode}"
                                          ToolTip="Sort capture history"
                                          Margin="0,0,0,8" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Content="Tagged only"
                                              IsChecked="{Binding CaptureHistory.TaggedOnly}" />
                                    <CheckBox Grid.Column="1"
                                              Content="Saturated only"
                                              IsChecked="{Binding CaptureHistory.SaturatedOnly}" />
                                </Grid>
                                <TextBlock Text="{Binding CaptureHistory.FilterSummaryText}"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,0,0,8" />

                                <ListBox ItemsSource="{Binding CaptureHistory.Captures}"
                                         SelectedItem="{Binding CaptureHistory.SelectedCapture}"
                                         MaxHeight="260"
                                         Background="#0D141C"
                                         BorderBrush="{StaticResource BorderBrush}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="4">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           Style="{StaticResource ValueText}" />
                                                <TextBlock Text="{Binding DetailText}"
                                                           Style="{StaticResource MutedText}" />
                                                <TextBlock Text="{Binding SessionName}"
                                                           Style="{StaticResource MutedText}" />
                                                <TextBlock Text="{Binding TagsText}"
                                                           Style="{StaticResource MutedText}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="Compare A"
                                            Command="{Binding CaptureHistory.SetCompareACommand}"
                                            Margin="0,0,6,0" />
                                    <Button Grid.Column="1"
                                            Content="Compare B"
                                            Command="{Binding CaptureHistory.SetCompareBCommand}"
                                            Margin="6,0,0,0" />
                                </Grid>
                                <TextBlock Text="{Binding CaptureHistory.ComparisonText}"
                                           Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,10" />

                                <TextBlock Text="Export Captures"
                                           Style="{StaticResource LabelText}"
                                           Margin="0,0,0,6" />
                                <TextBox Text="{Binding CaptureHistory.ExportDirectory, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Destination folder for explicit image and metadata export"
                                         Margin="0,0,0,6" />
                                <TextBox Text="{Binding CaptureHistory.FilenameTemplate, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Filename template: {session}, {timestamp}, {captureIndex}, {exposure}, {source}, {frameNumber}, {cameraModel}, {captureId}"
                                         Margin="0,0,0,8" />
                                <UniformGrid Columns="2" Margin="0,0,0,8">
                                    <CheckBox Content="16-bit TIFF"
                                              IsChecked="{Binding CaptureHistory.ExportTiff16}" />
                                    <CheckBox Content="PNG Preview"
                                              IsChecked="{Binding CaptureHistory.ExportPngPreview}" />
                                    <CheckBox Content="Raw Mono16"
                                              IsChecked="{Binding CaptureHistory.ExportRawMono16}" />
                                    <CheckBox Content="JSON Metadata"
                                              IsChecked="{Binding CaptureHistory.ExportJsonMetadata}" />
                                    <CheckBox Content="Manifest"
                                              IsChecked="{Binding CaptureHistory.CreateManifest}" />
                                </UniformGrid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Text="Layout" Style="{StaticResource LabelText}" />
                                        <ComboBox ItemsSource="{Binding CaptureHistory.ExportDirectoryLayouts}"
                                                  SelectedItem="{Binding CaptureHistory.ExportDirectoryLayout}"
                                                  Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="Collision" Style="{StaticResource LabelText}" />
                                        <ComboBox ItemsSource="{Binding CaptureHistory.ExportCollisionBehaviors}"
                                                  SelectedItem="{Binding CaptureHistory.ExportCollisionBehavior}"
                                                  Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding CaptureHistory.EstimatedExportSizeText}"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,0,0,6" />
                                <ProgressBar Minimum="0"
                                             Maximum="100"
                                             Value="{Binding CaptureHistory.ExportProgressValue, Mode=OneWay}"
                                             Height="8"
                                             Margin="0,0,0,6" />
                                <TextBlock Text="{Binding CaptureHistory.ExportStatus}"
                                           Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8" />
                                <UniformGrid Columns="2" Margin="0,0,0,8">
                                    <Button Content="Export Capture"
                                            Command="{Binding CaptureHistory.ExportSelectedCommand}"
                                            Style="{StaticResource PrimaryButton}"
                                            Margin="0,0,6,6" />
                                    <Button Content="Export Filtered"
                                            Command="{Binding CaptureHistory.ExportFilteredCommand}"
                                            Margin="6,0,0,6" />
                                    <Button Content="Export Session"
                                            Command="{Binding CaptureHistory.ExportSessionCommand}"
                                            Margin="0,0,6,0" />
                                    <Button Content="Cancel Export"
                                            Command="{Binding CaptureHistory.CancelExportCommand}"
                                            Style="{StaticResource DangerButton}"
                                            Margin="6,0,0,0" />
                                </UniformGrid>

                                <TextBlock Text="Selected Capture"
                                           Style="{StaticResource LabelText}"
                                           Margin="0,0,0,6" />
                                <TextBlock Text="{Binding CaptureHistory.SelectedCaptureIdText, StringFormat=ID: {0}}"
                                           Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding CaptureHistory.SelectedCaptureSessionText, StringFormat=Session: {0}}"
                                           Style="{StaticResource MutedText}" />
                                <TextBlock Text="{Binding CaptureHistory.SelectedCaptureSourceText, StringFormat=Source: {0}}"
                                           Style="{StaticResource MutedText}" />
                                <TextBlock Text="{Binding CaptureHistory.SelectedCaptureTimestampText, StringFormat=Timestamp: {0}}"
                                           Style="{StaticResource MutedText}" />
                                <TextBlock Text="{Binding CaptureHistory.SelectedCaptureCameraText, StringFormat=Camera: {0}}"
                                           Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding CaptureHistory.SelectedCaptureExposureText, StringFormat=Exposure: {0}}"
                                           Style="{StaticResource MutedText}" />
                                <TextBlock Text="{Binding CaptureHistory.SelectedCaptureGainText, StringFormat=Gain: {0}}"
                                           Style="{StaticResource MutedText}" />
                                <TextBlock Text="{Binding CaptureHistory.SelectedCaptureResolutionText, StringFormat=Resolution: {0}}"
                                           Style="{StaticResource MutedText}" />
                                <TextBlock Text="{Binding CaptureHistory.SelectedCaptureFormatText, StringFormat=Format: {0}}"
                                           Style="{StaticResource MutedText}" />
                                <TextBlock Text="{Binding CaptureHistory.SelectedCaptureTriggerText, StringFormat=Trigger: {0}}"
                                           Style="{StaticResource MutedText}" />
                                <TextBlock Text="{Binding CaptureHistory.SelectedCaptureStatisticsText}"
                                           Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding CaptureHistory.SelectedCapturePropertySnapshotText, StringFormat=Properties: {0}}"
                                           Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10" />

                                <TextBlock Text="Notes" Style="{StaticResource LabelText}" />
                                <TextBox Text="{Binding CaptureHistory.NotesText, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         Height="58"
                                         TextWrapping="Wrap"
                                         ToolTip="In-memory notes for the selected capture"
                                         Margin="0,4,0,6" />
                                <Button Content="Save Notes"
                                        Command="{Binding CaptureHistory.SaveNotesCommand}"
                                        Margin="0,0,0,8" />

                                <TextBlock Text="Tags" Style="{StaticResource LabelText}" />
                                <Grid Margin="0,4,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding CaptureHistory.TagText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Add a tag to the selected capture"
                                             Margin="0,0,8,0" />
                                    <Button Grid.Column="1"
                                            Content="Add"
                                            Command="{Binding CaptureHistory.AddTagCommand}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding CaptureHistory.SelectedCapture.Record.Tags}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding}"
                                                    Command="{Binding DataContext.CaptureHistory.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Margin="0,0,6,6" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <UniformGrid Columns="2" Margin="0,4,0,0">
                                    <Button Content="Delete Capture"
                                            Command="{Binding CaptureHistory.DeleteCaptureCommand}"
                                            Style="{StaticResource DangerButton}"
                                            Margin="0,0,6,0" />
                                    <Button Content="Clear History"
                                            Command="{Binding CaptureHistory.ClearHistoryCommand}"
                                            Style="{StaticResource DangerButton}"
                                            Margin="6,0,0,0" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Diagnostics"
                                           Style="{StaticResource SectionHeadingText}"
                                           Margin="0,0,0,10" />
                                <TextBlock Text="{Binding Diagnostics.HealthSummaryText}"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8" />
                                <TextBlock Text="{Binding Diagnostics.ApplicationText}"
                                           Style="{StaticResource ValueText}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Diagnostics.RuntimeText}"
                                           Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0" />
                                <TextBlock Text="{Binding Diagnostics.UptimeText, StringFormat=Uptime: {0}}"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,4,0,8" />
                                <TextBlock Text="{Binding Diagnostics.CameraText}"
                                           Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,4" />
                                <TextBlock Text="{Binding Diagnostics.AcquisitionText}"
                                           Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,4" />
                                <TextBlock Text="{Binding Diagnostics.ImagingText}"
                                           Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,4" />
                                <TextBlock Text="{Binding Diagnostics.HistoryText}"
                                           Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,4" />
                                <TextBlock Text="{Binding Diagnostics.ExportText}"
                                           Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,4" />
                                <TextBlock Text="{Binding Diagnostics.RecentErrorsText}"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,0,0,10" />

                                <TextBlock Text="Logs"
                                           Style="{StaticResource LabelText}"
                                           Margin="0,0,0,6" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding Diagnostics.LogLevels}"
                                              SelectedItem="{Binding Diagnostics.MinimumLogLevel}"
                                              ToolTip="Minimum log level for the in-memory log view" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding Diagnostics.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Search recent log messages and properties"
                                             Margin="8,0,0,0" />
                                </Grid>
                                <TextBox Text="{Binding Diagnostics.CategoryFilter, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Filter by logger category"
                                         Margin="0,0,0,8" />
                                <CheckBox Content="Pause log view"
                                          IsChecked="{Binding Diagnostics.IsPaused}"
                                          Margin="0,0,0,8" />
                                <ListBox ItemsSource="{Binding Diagnostics.LogEntries}"
                                         MaxHeight="160"
                                         Background="#0D141C"
                                         BorderBrush="{StaticResource BorderBrush}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="4">
                                                <TextBlock Text="{Binding Message}"
                                                           Style="{StaticResource ValueText}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Style="{StaticResource MutedText}">
                                                    <Run Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" />
                                                    <Run Text=" " />
                                                    <Run Text="{Binding Level}" />
                                                    <Run Text=" " />
                                                    <Run Text="{Binding Category}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="{Binding Diagnostics.LogDirectoryText, StringFormat=Logs: {0}}"
                                           Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,8" />
                                <UniformGrid Columns="2">
                                    <Button Content="Copy Diagnostics"
                                            Command="{Binding Diagnostics.CopyDiagnosticsCommand}"
                                            Margin="0,0,6,6" />
                                    <Button Content="Open Logs"
                                            Command="{Binding Diagnostics.OpenLogFolderCommand}"
                                            Margin="6,0,0,6" />
                                    <Button Content="Clear View"
                                            Command="{Binding Diagnostics.ClearLogViewCommand}"
                                            Margin="0,0,6,0" />
                                    <Button Content="Support Bundle"
                                            Command="{Binding Diagnostics.CreateSupportBundleCommand}"
                                            Style="{StaticResource PrimaryButton}"
                                            Margin="6,0,0,0" />
                                </UniformGrid>
                                <TextBlock Text="{Binding Diagnostics.SupportBundleStatus}"
                                           Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Camera Property Explorer"
                                           Style="{StaticResource SectionHeadingText}"
                                           Margin="0,0,0,10" />
                                <TextBlock Text="Search" Style="{StaticResource LabelText}" />
                                <TextBox Text="{Binding PropertyExplorer.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Search display name, property ID, category, or description"
                                         Margin="0,4,0,8" />
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding PropertyExplorer.CategoryOptions}"
                                              SelectedItem="{Binding PropertyExplorer.SelectedCategory}"
                                              ToolTip="Filter by property category"
                                              Margin="0,0,8,0" />
                                    <CheckBox Grid.Column="1"
                                              Content="Writable only"
                                              IsChecked="{Binding PropertyExplorer.WritableOnly}"
                                              VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="{Binding PropertyExplorer.CountsText}"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,0,0,8" />
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding PropertyExplorer.Message}"
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Content="Refresh"
                                            Command="{Binding PropertyExplorer.RefreshCommand}"
                                            ToolTip="Reload authoritative camera property values"
                                            Margin="8,0,0,0" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding PropertyExplorer.FilteredProperties}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    Background="#121B24"
                                                    Padding="10"
                                                    Margin="0,0,0,10">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Category}"
                                                                       Style="{StaticResource LabelText}" />
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       Style="{StaticResource ValueText}" />
                                                            <TextBlock Text="{Binding Id}"
                                                                       Style="{StaticResource MutedText}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding AccessText}"
                                                                   Style="{StaticResource LabelText}"
                                                                   Margin="8,0,0,0" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding Description}"
                                                               Style="{StaticResource MutedText}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,6,0,0" />
                                                    <TextBlock Text="{Binding MetadataText}"
                                                               Style="{StaticResource MutedText}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,4,0,8" />
                                                    <TextBlock Text="{Binding CurrentValueText, StringFormat=Current: {0}}"
                                                               Style="{StaticResource MutedText}"
                                                               Margin="0,0,0,6" />

                                                    <TextBox Text="{Binding EditableValue, UpdateSourceTrigger=PropertyChanged}"
                                                             IsEnabled="{Binding CanEdit}"
                                                             Visibility="{Binding IsNumericOrText, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                             Margin="0,0,0,6" />
                                                    <CheckBox Content="Enabled"
                                                              IsChecked="{Binding EditableBoolean}"
                                                              IsEnabled="{Binding CanEdit}"
                                                              Visibility="{Binding IsBoolean, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                              Margin="0,0,0,6" />
                                                    <ComboBox ItemsSource="{Binding Options}"
                                                              SelectedItem="{Binding SelectedOption}"
                                                              DisplayMemberPath="DisplayName"
                                                              IsEnabled="{Binding CanEdit}"
                                                              Visibility="{Binding IsEnumeration, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                              Margin="0,0,0,6" />

                                                    <TextBlock Text="{Binding ErrorMessage}"
                                                               Foreground="{StaticResource WarningBrush}"
                                                               FontSize="12"
                                                               TextWrapping="Wrap"
                                                               Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                               Margin="0,0,0,6" />

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Modified"
                                                                   Style="{StaticResource MutedText}"
                                                                   Visibility="{Binding IsDirty, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                   VerticalAlignment="Center" />
                                                        <Button Grid.Column="1"
                                                                Content="Revert"
                                                                Command="{Binding RevertCommand}"
                                                                Margin="8,0,0,0" />
                                                        <Button Grid.Column="2"
                                                                Content="Apply"
                                                                Command="{Binding ApplyCommand}"
                                                                Style="{StaticResource PrimaryButton}"
                                                                Margin="8,0,0,0" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Exposure Sweep"
                                           Style="{StaticResource SectionHeadingText}"
                                           Margin="0,0,0,10" />
                                <TextBlock Text="Start" Style="{StaticResource LabelText}" />
                                <Grid Margin="0,4,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="96" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding SweepStartValue, UpdateSourceTrigger=PropertyChanged}" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding ExposureUnits}" SelectedItem="{Binding SweepStartUnit}" Margin="8,0,0,0">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource ExposureUnitLabelConverter}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                                <TextBlock Text="End" Style="{StaticResource LabelText}" />
                                <Grid Margin="0,4,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="96" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding SweepEndValue, UpdateSourceTrigger=PropertyChanged}" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding ExposureUnits}" SelectedItem="{Binding SweepEndUnit}" Margin="8,0,0,0">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource ExposureUnitLabelConverter}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                                <TextBlock Text="Step" Style="{StaticResource LabelText}" />
                                <Grid Margin="0,4,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="96" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding SweepStepValue, UpdateSourceTrigger=PropertyChanged}" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding ExposureUnits}" SelectedItem="{Binding SweepStepUnit}" Margin="8,0,0,0">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource ExposureUnitLabelConverter}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Text="Frames / Exposure" Style="{StaticResource LabelText}" />
                                        <TextBox Text="{Binding FramesPerExposure, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="Delay (ms)" Style="{StaticResource LabelText}" />
                                        <TextBox Text="{Binding DelayBetweenCapturesMilliseconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding SweepPreviewText}"
                                           Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,8" />
                                <TextBlock Text="{Binding SweepValidationMessage}"
                                           Foreground="{StaticResource WarningBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding HasSweepValidationMessage, Converter={StaticResource BooleanToVisibilityConverter}}"
                                           Margin="0,0,0,8" />
                                <ProgressBar Minimum="0"
                                             Maximum="100"
                                             Value="{Binding SweepProgressValue, Mode=OneWay}"
                                             Height="8"
                                             Margin="0,0,0,8" />
                                <TextBlock Text="{Binding SweepProgressText}" Style="{StaticResource MutedText}" />
                                <TextBlock Text="{Binding SweepCurrentExposureText, StringFormat=Current Exposure: {0}}" Style="{StaticResource MutedText}" Margin="0,4,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Content="Run Sweep"
                                            Command="{Binding RunSweepCommand}"
                                            Style="{StaticResource PrimaryButton}"
                                            Margin="0,0,6,0" />
                                    <Button Grid.Column="1"
                                            Content="Cancel"
                                            Command="{Binding CancelSweepCommand}"
                                            Style="{StaticResource DangerButton}"
                                            Margin="6,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Sweep Results"
                                           Style="{StaticResource SectionHeadingText}"
                                           Margin="0,0,0,10" />
                                <ListBox ItemsSource="{Binding SweepResults}"
                                         SelectedItem="{Binding SelectedSweepResult}"
                                         Height="112"
                                         Margin="0,0,0,10">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               Foreground="{StaticResource PrimaryTextBrush}"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding SaturationState}"
                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                               FontSize="11" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding SaturationText}"
                                                           Foreground="{StaticResource WarningBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="12,0,0,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="Previous"
                                            Command="{Binding PreviousSweepResultCommand}"
                                            Margin="0,0,6,0" />
                                    <Button Grid.Column="1"
                                            Content="Next"
                                            Command="{Binding NextSweepResultCommand}"
                                            Margin="6,0,0,0" />
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Exposure" Style="{StaticResource LabelText}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedSweepExposureText}" Style="{StaticResource ValueText}" />
                                    <TextBlock Grid.Row="1" Text="Frame" Style="{StaticResource LabelText}" Margin="0,5,0,0" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedSweepFrameText}" Style="{StaticResource ValueText}" Margin="0,5,0,0" />
                                    <TextBlock Grid.Row="2" Text="Mean" Style="{StaticResource LabelText}" Margin="0,5,0,0" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedSweepMeanText}" Style="{StaticResource ValueText}" Margin="0,5,0,0" />
                                    <TextBlock Grid.Row="3" Text="Min / Max" Style="{StaticResource LabelText}" Margin="0,5,0,0" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedSweepMinMaxText}" Style="{StaticResource ValueText}" Margin="0,5,0,0" />
                                    <TextBlock Grid.Row="4" Text="Saturation" Style="{StaticResource LabelText}" Margin="0,5,0,0" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedSweepSaturationText}" Style="{StaticResource ValueText}" Margin="0,5,0,0" />
                                    <TextBlock Grid.Row="5" Text="State" Style="{StaticResource LabelText}" Margin="0,5,0,0" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedSweepSaturationState}" Style="{StaticResource ValueText}" Margin="0,5,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="16,0,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource PanelBorder}"
                    Padding="14"
                    Margin="0,0,7,0">
                <StackPanel>
                    <TextBlock Text="FRAME INFO"
                               Style="{StaticResource SectionHeadingText}"
                               Margin="0,0,0,10" />
                    <UniformGrid Columns="5">
                        <StackPanel>
                            <TextBlock Text="Minimum" Style="{StaticResource LabelText}" />
                            <TextBlock Text="{Binding MinimumPixelText}" Style="{StaticResource ValueText}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Maximum" Style="{StaticResource LabelText}" />
                            <TextBlock Text="{Binding MaximumPixelText}" Style="{StaticResource ValueText}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Mean" Style="{StaticResource LabelText}" />
                            <TextBlock Text="{Binding MeanPixelText}" Style="{StaticResource ValueText}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Saturated" Style="{StaticResource LabelText}" />
                            <TextBlock Text="{Binding SaturatedPixelText}" Style="{StaticResource ValueText}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Saturation" Style="{StaticResource LabelText}" />
                            <TextBlock Text="{Binding SaturationText}" Style="{StaticResource ValueText}" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource PanelBorder}"
                    Padding="14"
                    Margin="7,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="HISTOGRAM"
                               Style="{StaticResource SectionHeadingText}"
                               Margin="0,0,0,10" />
                    <TextBlock Grid.Column="1"
                               Text="EXPOSURE RESPONSE"
                               Style="{StaticResource SectionHeadingText}"
                               Margin="14,0,0,10" />
                    <Grid Grid.Row="1">
                        <controls:HistogramControl Bins="{Binding HistogramBins}"
                                                   Stroke="{StaticResource AccentBrush}"
                                                   Scale="{Binding SelectedHistogramScale}"
                                                   RangeMode="{Binding SelectedHistogramDisplayRange}"
                                                   BlackPoint="{Binding EffectiveBlackPoint}"
                                                   WhitePoint="{Binding EffectiveWhitePoint}"
                                                   ThresholdEnabled="{Binding ThresholdEnabled}"
                                                   ThresholdValue="{Binding ThresholdValue}" />
                        <TextBlock Text="No histogram data"
                                   Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding NoPreviewImage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                    <Grid Grid.Row="1" Grid.Column="1" Margin="14,0,0,0">
                        <controls:ExposureResponseChartControl Results="{Binding SweepResults}" />
                        <TextBlock Text="Run an exposure sweep to chart exposure versus mean intensity."
                                   Style="{StaticResource MutedText}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   MaxWidth="320"
                                   Visibility="{Binding HasSweepResults, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="{Binding BusyVisibility}">
                    <ProgressBar Width="80"
                                 Height="8"
                                 IsIndeterminate="True"
                                 Margin="0,0,10,0" />
                    <TextBlock Text="Working"
                               Style="{StaticResource MutedText}"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage}"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</Window>
