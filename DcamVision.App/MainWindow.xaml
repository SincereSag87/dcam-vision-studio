<Window x:Class="DcamVision.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DcamVision.App.Controls"
        Title="DCAM Vision Studio"
        MinHeight="720"
        MinWidth="1120"
        Height="820"
        Width="1320"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
            <RowDefinition Height="188" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="22,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="DCAM Vision Studio"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               FontSize="22"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Scientific Camera Control"
                               Style="{StaticResource MutedText}"
                               Margin="0,3,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Ellipse Width="10"
                             Height="10"
                             Fill="{Binding StatusIndicatorBrush}"
                             Margin="0,0,8,0" />
                    <StackPanel>
                        <TextBlock Text="{Binding HeaderStatusText}"
                                   Style="{StaticResource ValueText}"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding HeaderDeviceText}"
                                   Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding HeaderSimulatorText}"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right"
                                   Visibility="{Binding IsSelectedDeviceSimulated, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16,16,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource PanelBorder}"
                    Padding="14">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CAMERA"
                                       Style="{StaticResource SectionHeadingText}"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Content="Discover"
                                    Command="{Binding DiscoverCommand}"
                                    ToolTip="Scan for available cameras"
                                    TabIndex="0" />
                        </Grid>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedDeviceName}"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <Border Background="#243C45"
                                        BorderBrush="{StaticResource AccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="7,3"
                                        HorizontalAlignment="Left"
                                        Margin="0,8,0,10">
                                    <TextBlock Text="{Binding SelectedDeviceKind}"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               FontSize="11"
                                               FontWeight="SemiBold" />
                                </Border>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Manufacturer" Style="{StaticResource LabelText}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedManufacturer}" Style="{StaticResource ValueText}" />
                                    <TextBlock Grid.Row="1" Text="Model" Style="{StaticResource LabelText}" Margin="0,7,0,0" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedModel}" Style="{StaticResource ValueText}" Margin="0,7,0,0" />
                                    <TextBlock Grid.Row="2" Text="Serial" Style="{StaticResource LabelText}" Margin="0,7,0,0" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedSerialNumber}" Style="{StaticResource ValueText}" Margin="0,7,0,0" />
                                    <TextBlock Grid.Row="3" Text="Status" Style="{StaticResource LabelText}" Margin="0,7,0,0" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedConnectionState}" Style="{StaticResource ValueText}" Margin="0,7,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <TextBlock Text="CONTROLS"
                                   Style="{StaticResource SectionHeadingText}"
                                   Margin="0,0,0,10" />
                        <Button Content="{Binding ConnectButtonText}"
                                Command="{Binding ToggleConnectionCommand}"
                                Style="{StaticResource PrimaryButton}"
                                ToolTip="Connect or disconnect the selected camera"
                                TabIndex="2" />
                    </StackPanel>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Devices"
                                   Style="{StaticResource LabelText}"
                                   Margin="0,0,0,6" />
                        <Grid Grid.Row="1">
                            <ListBox ItemsSource="{Binding Devices}"
                                     SelectedItem="{Binding SelectedDevice}"
                                     DisplayMemberPath="DisplayName"
                                     TabIndex="1" />
                            <StackPanel VerticalAlignment="Center"
                                        Margin="16"
                                        Visibility="{Binding NoDevices, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="No cameras discovered"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Run discovery to find available devices."
                                           Style="{StaticResource MutedText}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </DockPanel>
            </Border>

            <Border Grid.Column="1"
                    Margin="14,0"
                    Style="{StaticResource PanelBorder}"
                    Background="{StaticResource ViewportBackgroundBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="14,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="LIVE IMAGE VIEW"
                                   Style="{StaticResource SectionHeadingText}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Fit"
                                    Style="{StaticResource ToolbarButton}"
                                    IsEnabled="False"
                                    ToolTip="Fit view mode is the current Phase 2 display mode"
                                    Margin="0,0,8,0" />
                            <Button Content="100%"
                                    Style="{StaticResource ToolbarButton}"
                                    IsEnabled="False"
                                    ToolTip="Pixel-accurate zoom is planned for a later phase"
                                    Margin="0,0,12,0" />
                            <CheckBox Content="Auto Contrast"
                                      IsChecked="{Binding IsAutoContrastEnabled}"
                                      ToolTip="Map the current frame min/max into the 8-bit preview"
                                      TabIndex="7" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="14,0,14,12">
                        <Border BorderBrush="#27333F"
                                BorderThickness="1"
                                Background="#05080B">
                            <Grid ClipToBounds="True">
                                <Image Source="{Binding PreviewImage}"
                                       Stretch="Uniform"
                                       SnapsToDevicePixels="True" />
                                <StackPanel VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            Visibility="{Binding NoPreviewImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="No image available"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Connect to a camera and capture a frame or start live acquisition."
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="13"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               MaxWidth="360"
                                               Margin="0,8,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2"
                            Background="#111922"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="14,10">
                        <UniformGrid Columns="5">
                            <StackPanel>
                                <TextBlock Text="Frame" Style="{StaticResource LabelText}" />
                                <TextBlock Text="{Binding FrameNumberText}" Style="{StaticResource ValueText}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Dimensions" Style="{StaticResource LabelText}" />
                                <TextBlock Text="{Binding FrameDimensionsText}" Style="{StaticResource ValueText}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Pixel Format" Style="{StaticResource LabelText}" />
                                <TextBlock Text="{Binding FramePixelFormatText}" Style="{StaticResource ValueText}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Exposure" Style="{StaticResource LabelText}" />
                                <TextBlock Text="{Binding FrameExposureText}" Style="{StaticResource ValueText}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Timestamp" Style="{StaticResource LabelText}" />
                                <TextBlock Text="{Binding FrameTimestampText}" Style="{StaticResource ValueText}" />
                            </StackPanel>
                        </UniformGrid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource PanelBorder}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="CAMERA SETTINGS"
                                   Style="{StaticResource SectionHeadingText}"
                                   Margin="0,0,0,12" />

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Acquisition"
                                           Style="{StaticResource SectionHeadingText}"
                                           Margin="0,0,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Content="Capture"
                                            Command="{Binding CaptureCommand}"
                                            Style="{StaticResource PrimaryButton}"
                                            ToolTip="Capture one frame"
                                            TabIndex="3"
                                            Margin="0,0,6,0" />
                                    <Button Grid.Column="1"
                                            Content="Start Live"
                                            Command="{Binding StartLiveCommand}"
                                            ToolTip="Start continuous simulated acquisition"
                                            TabIndex="4"
                                            Margin="6,0,0,0" />
                                </Grid>
                                <Button Content="Stop Live"
                                        Command="{Binding StopLiveCommand}"
                                        Style="{StaticResource DangerButton}"
                                        ToolTip="Stop continuous acquisition"
                                        TabIndex="5"
                                        Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Exposure Time"
                                           Style="{StaticResource SectionHeadingText}"
                                           Margin="0,0,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="96" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding ExposureValue, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Enter an exposure in the selected unit"
                                             TabIndex="6">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding ApplyExposureCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding ExposureUnits}"
                                              SelectedItem="{Binding SelectedExposureUnit}"
                                              Margin="8,0,0,0"
                                              TabIndex="7">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource ExposureUnitLabelConverter}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                                <Slider Minimum="0"
                                        Maximum="100"
                                        Value="{Binding ExposureSliderValue, UpdateSourceTrigger=PropertyChanged}"
                                        TickFrequency="20"
                                        IsSnapToTickEnabled="False"
                                        ToolTip="Logarithmic exposure adjustment"
                                        Margin="0,12,0,0"
                                        TabIndex="8" />
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="100 µs" Style="{StaticResource MutedText}" />
                                    <TextBlock Grid.Column="1" Text="100 ms" Style="{StaticResource MutedText}" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="10 s" Style="{StaticResource MutedText}" HorizontalAlignment="Right" />
                                </Grid>
                                <TextBlock Text="Current:"
                                           Style="{StaticResource LabelText}"
                                           Margin="0,10,0,0" />
                                <TextBlock Text="{Binding CurrentExposureText}"
                                           Style="{StaticResource ValueText}" />
                                <TextBlock Text="{Binding SupportedExposureRangeText, StringFormat=Supported range: {0}}"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,6,0,0" />
                                <TextBlock Text="{Binding PendingExposureText, StringFormat=Pending: {0}}"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,4,0,0" />
                                <TextBlock Text="{Binding ExposureValidationMessage}"
                                           Foreground="{StaticResource WarningBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0"
                                           Visibility="{Binding HasExposureValidationMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Button Content="Apply Exposure"
                                        Command="{Binding ApplyExposureCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        IsDefault="True"
                                        ToolTip="Apply the exposure value to the camera service"
                                        TabIndex="9"
                                        Margin="0,12,0,0" />
                                <TextBlock Text="Presets"
                                           Style="{StaticResource LabelText}"
                                           Margin="0,14,0,8" />
                                <ItemsControl ItemsSource="{Binding ExposurePresets}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding DisplayName}"
                                                    Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding IsSupported}"
                                                    ToolTip="Apply exposure preset"
                                                    Margin="0,0,8,8">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource AccentDarkBrush}" />
                                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Property Summary"
                                           Style="{StaticResource SectionHeadingText}"
                                           Margin="0,0,0,10" />
                                <ItemsControl ItemsSource="{Binding PropertySummaries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource LabelText}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource ValueText}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Connect to a camera to load properties."
                                           Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding IsDisconnected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Exposure Sweep"
                                           Style="{StaticResource SectionHeadingText}"
                                           Margin="0,0,0,10" />
                                <TextBlock Text="Start" Style="{StaticResource LabelText}" />
                                <Grid Margin="0,4,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="96" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding SweepStartValue, UpdateSourceTrigger=PropertyChanged}" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding ExposureUnits}" SelectedItem="{Binding SweepStartUnit}" Margin="8,0,0,0">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource ExposureUnitLabelConverter}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                                <TextBlock Text="End" Style="{StaticResource LabelText}" />
                                <Grid Margin="0,4,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="96" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding SweepEndValue, UpdateSourceTrigger=PropertyChanged}" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding ExposureUnits}" SelectedItem="{Binding SweepEndUnit}" Margin="8,0,0,0">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource ExposureUnitLabelConverter}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                                <TextBlock Text="Step" Style="{StaticResource LabelText}" />
                                <Grid Margin="0,4,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="96" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding SweepStepValue, UpdateSourceTrigger=PropertyChanged}" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding ExposureUnits}" SelectedItem="{Binding SweepStepUnit}" Margin="8,0,0,0">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource ExposureUnitLabelConverter}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Text="Frames / Exposure" Style="{StaticResource LabelText}" />
                                        <TextBox Text="{Binding FramesPerExposure, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="Delay (ms)" Style="{StaticResource LabelText}" />
                                        <TextBox Text="{Binding DelayBetweenCapturesMilliseconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding SweepPreviewText}"
                                           Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,8" />
                                <TextBlock Text="{Binding SweepValidationMessage}"
                                           Foreground="{StaticResource WarningBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding HasSweepValidationMessage, Converter={StaticResource BooleanToVisibilityConverter}}"
                                           Margin="0,0,0,8" />
                                <ProgressBar Minimum="0"
                                             Maximum="100"
                                             Value="{Binding SweepProgressValue}"
                                             Height="8"
                                             Margin="0,0,0,8" />
                                <TextBlock Text="{Binding SweepProgressText}" Style="{StaticResource MutedText}" />
                                <TextBlock Text="{Binding SweepCurrentExposureText, StringFormat=Current Exposure: {0}}" Style="{StaticResource MutedText}" Margin="0,4,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Content="Run Sweep"
                                            Command="{Binding RunSweepCommand}"
                                            Style="{StaticResource PrimaryButton}"
                                            Margin="0,0,6,0" />
                                    <Button Grid.Column="1"
                                            Content="Cancel"
                                            Command="{Binding CancelSweepCommand}"
                                            Style="{StaticResource DangerButton}"
                                            Margin="6,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Sweep Results"
                                           Style="{StaticResource SectionHeadingText}"
                                           Margin="0,0,0,10" />
                                <ListBox ItemsSource="{Binding SweepResults}"
                                         SelectedItem="{Binding SelectedSweepResult}"
                                         Height="112"
                                         Margin="0,0,0,10">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               Foreground="{StaticResource PrimaryTextBrush}"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding SaturationState}"
                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                               FontSize="11" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding SaturationText}"
                                                           Foreground="{StaticResource WarningBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="12,0,0,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="Previous"
                                            Command="{Binding PreviousSweepResultCommand}"
                                            Margin="0,0,6,0" />
                                    <Button Grid.Column="1"
                                            Content="Next"
                                            Command="{Binding NextSweepResultCommand}"
                                            Margin="6,0,0,0" />
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Exposure" Style="{StaticResource LabelText}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedSweepExposureText}" Style="{StaticResource ValueText}" />
                                    <TextBlock Grid.Row="1" Text="Frame" Style="{StaticResource LabelText}" Margin="0,5,0,0" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedSweepFrameText}" Style="{StaticResource ValueText}" Margin="0,5,0,0" />
                                    <TextBlock Grid.Row="2" Text="Mean" Style="{StaticResource LabelText}" Margin="0,5,0,0" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedSweepMeanText}" Style="{StaticResource ValueText}" Margin="0,5,0,0" />
                                    <TextBlock Grid.Row="3" Text="Min / Max" Style="{StaticResource LabelText}" Margin="0,5,0,0" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedSweepMinMaxText}" Style="{StaticResource ValueText}" Margin="0,5,0,0" />
                                    <TextBlock Grid.Row="4" Text="Saturation" Style="{StaticResource LabelText}" Margin="0,5,0,0" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedSweepSaturationText}" Style="{StaticResource ValueText}" Margin="0,5,0,0" />
                                    <TextBlock Grid.Row="5" Text="State" Style="{StaticResource LabelText}" Margin="0,5,0,0" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedSweepSaturationState}" Style="{StaticResource ValueText}" Margin="0,5,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="16,0,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource PanelBorder}"
                    Padding="14"
                    Margin="0,0,7,0">
                <StackPanel>
                    <TextBlock Text="FRAME INFO"
                               Style="{StaticResource SectionHeadingText}"
                               Margin="0,0,0,10" />
                    <UniformGrid Columns="5">
                        <StackPanel>
                            <TextBlock Text="Minimum" Style="{StaticResource LabelText}" />
                            <TextBlock Text="{Binding MinimumPixelText}" Style="{StaticResource ValueText}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Maximum" Style="{StaticResource LabelText}" />
                            <TextBlock Text="{Binding MaximumPixelText}" Style="{StaticResource ValueText}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Mean" Style="{StaticResource LabelText}" />
                            <TextBlock Text="{Binding MeanPixelText}" Style="{StaticResource ValueText}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Saturated" Style="{StaticResource LabelText}" />
                            <TextBlock Text="{Binding SaturatedPixelText}" Style="{StaticResource ValueText}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Saturation" Style="{StaticResource LabelText}" />
                            <TextBlock Text="{Binding SaturationText}" Style="{StaticResource ValueText}" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource PanelBorder}"
                    Padding="14"
                    Margin="7,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="HISTOGRAM"
                               Style="{StaticResource SectionHeadingText}"
                               Margin="0,0,0,10" />
                    <TextBlock Grid.Column="1"
                               Text="EXPOSURE RESPONSE"
                               Style="{StaticResource SectionHeadingText}"
                               Margin="14,0,0,10" />
                    <Grid Grid.Row="1">
                        <controls:HistogramControl Bins="{Binding HistogramBins}"
                                                   Stroke="{StaticResource AccentBrush}" />
                        <TextBlock Text="No histogram data"
                                   Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding NoPreviewImage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                    <Grid Grid.Row="1" Grid.Column="1" Margin="14,0,0,0">
                        <controls:ExposureResponseChartControl Results="{Binding SweepResults}" />
                        <TextBlock Text="Run an exposure sweep to chart exposure versus mean intensity."
                                   Style="{StaticResource MutedText}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   MaxWidth="320"
                                   Visibility="{Binding HasSweepResults, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="{Binding BusyVisibility}">
                    <ProgressBar Width="80"
                                 Height="8"
                                 IsIndeterminate="True"
                                 Margin="0,0,10,0" />
                    <TextBlock Text="Working"
                               Style="{StaticResource MutedText}"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage}"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</Window>
